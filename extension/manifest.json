{
  "manifest_version": 3,
  "name": "ExternalCall",
  "version": "0.2.0",
  "description": "User-controlled GPT, Claude and Grok Web file handoff and response collection.",
  "minimum_chrome_version": "125",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "debugger",
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://grok.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "ExternalCall"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
